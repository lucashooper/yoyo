# ElevenLabs — get key at https://elevenlabs.io
EXPO_PUBLIC_ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Optional: Conversational AI agent — when set, uses live WebSocket convai
EXPO_PUBLIC_ELEVENLABS_AGENT_ID=your_agent_id_here
# Optional: default TTS voice when agent ID is unset (overridden per language when possible)
EXPO_PUBLIC_ELEVENLABS_VOICE_ID=your_voice_id_here

# Supabase — optional; app uses local mock when unset
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Dev server — use Expo's v2 tunnel instead of broken legacy ngrok (SDK 57+)
# Requires `npx expo login`. Prefer: npm run start:tunnel
# EXPO_UNSTABLE_TUNNEL_V2=1
